generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subscriber {
  id           String   @id @default(cuid())
  jid          String   @unique // WhatsApp ID (phone@s.whatsapp.net o group@g.us)
  name         String?
  notifyRaces  Boolean  @default(true)
  notifyQualy  Boolean  @default(true)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SentAlert {
  id         String   @id @default(cuid())
  sessionKey String   @unique // e.g. "2026-season-monaco-race"
  sentAt     DateTime @default(now())
}

model SessionFile {
  id        String   @id // filename, e.g. "creds.json"
  content   String   @db.Text
  updatedAt DateTime @updatedAt
}

model ChatSettings {
  id        String   @id @default(cuid())
  jid       String   @unique // WhatsApp ID del chat (grupo o privado)
  botActive Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model PorraBet {
  id        String   @id @default(cuid())
  sport     String   @default("f1") // "f1" | "motogp"
  groupJid  String
  userJid   String
  userName  String
  season    Int
  round     Int
  raceName  String?
  p1Driver  String   // driverId
  p1Name    String   // display name
  p2Driver  String
  p2Name    String
  p3Driver  String
  p3Name    String
  p4Driver  String
  p4Name    String
  p5Driver  String
  p5Name    String
  dnfDriver     String   // driverId for DNF
  dnfName       String   // display name for DNF
  qualyP3Driver String?  // driverId for Qualifying P3
  qualyP3Name   String?  // display name for Qualifying P3
  points        Int?     // total points won in this GP (null if pending)
  breakdown     String?  // points explanation
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([sport, groupJid, season, round, userJid])
}
