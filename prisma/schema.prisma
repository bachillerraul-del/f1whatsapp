generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subscriber {
  id           String   @id @default(cuid())
  jid          String   @unique // WhatsApp ID (phone@s.whatsapp.net o group@g.us)
  name         String?
  notifyRaces  Boolean  @default(true)
  notifyQualy  Boolean  @default(true)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SentAlert {
  id         String   @id @default(cuid())
  sessionKey String   @unique // e.g. "2026-season-monaco-race"
  sentAt     DateTime @default(now())
}

model SessionFile {
  id        String   @id // filename, e.g. "creds.json"
  content   String   @db.Text
  updatedAt DateTime @updatedAt
}

model PorraBet {
  id        String   @id @default(cuid())
  groupJid  String
  userJid   String
  userName  String
  season    Int
  round     Int
  raceName  String?
  p4Driver  String   // driverId (e.g. "norris")
  p4Name    String   // display name (e.g. "Lando Norris")
  p5Driver  String   // driverId (e.g. "leclerc")
  p5Name    String   // display name (e.g. "Charles Leclerc")
  p6Driver  String   // driverId (e.g. "piastri")
  p6Name    String   // display name (e.g. "Oscar Piastri")
  alonsoPos Int      // predicted finish position (1-22)
  sainzPos  Int      // predicted finish position (1-22)
  points    Int?     // total points won in this GP (null if pending)
  breakdown String?  // points explanation
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupJid, season, round, userJid])
}
